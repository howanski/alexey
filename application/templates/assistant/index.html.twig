{% extends 'base.html.twig' %}
{% set breadcrumbs = [
	{'name': 'menu_record'|localised('assistant'), 'href': path('assistant_index')}
	]
%}

{% block pageContentPrimary %}
	{% include 'assistant/_main_selector_buttons.html.twig' with {
		'active_button': 'assistant_index',
	} only %}
	{% set empty_agent = {'displayNameShort': '*', 'id': null} %}
	{% set agents = {empty_agent}|merge(agents) %}
	{% if agents|length > 2 %}
		<div class="justify-center -my-4 flex flex-wrap">
			{% for agent in agents %}
				<a class="py-1 my-1 px-4 shadow-md no-underline rounded-full text-white font-sans font-semibold text-sm border-blue btn-primary hover:text-white hover:bg-blue-light focus:outline-none active:shadow-none mr-2{% if agent.id is same as (selectedAgent) %} bg-nord9{% else %} bg-nord1{% endif %}" href="{{ path('assistant_index', {assistantId: agent.id}) }}">
					{{ agent.displayNameShort }}
				</a>
			{% endfor %}
		</div>
	{% endif %}
{% endblock %}

{% block pageContentSecondary %}
	{% set table_data = {} %}
	{% for chat in chats %}
		{% set chat_view_path = path('assistant_chat_view', {'id': chat.id}) %}
		{% set actions %}
			{% include 'table_action_button.html.twig' with {
				'button_color_hover': 'bg-nord10',
				'href': chat_view_path,
				'name': 'view'|localised,
			} only %}
			{% include 'table_action_button_secure.html.twig' with {
				'button_color_hover': 'bg-red-600',
				'href': path('assistant_chat_delete', {id: chat.id}),
				'confirmation': 'you_sure_delete'|localised,
				'name': 'delete'|localised,
				'csrf': csrf_token('delete_chat_' ~ chat.id),
			} only %}
			{%  if chat.lastChild.isOnErrorStatus  %}
				{% include 'table_action_button_secure.html.twig' with {
					'button_color_hover': 'bg-red-600',
					'confirmation': 'you_sure_redo'|localised('assistant'),
					'csrf': csrf_token('redo_chat_' ~ chat.lastChild.id),
					'href': path('assistant_ajax_redo', {id: chat.lastChild.id}),
					'name': '<i class="fas fa-redo"></i>',
				} only %}
			{% endif %}
		{% endset %}

		{% set visibility_icon = '<i class="fas fa-circle text-nord-14"></i>' %}
		{% if not chat.isRead or chat.lastChild.isOnErrorStatus %}
			{% set visibility_icon = '<i class="fas fa-circle text-nord-11"></i>' %}
		{% endif %}

		{% set status_row %}
			<a href="{{ chat_view_path }}">
				{{ chat.statusEffective|lower|localised('assistant') }}
				{%  if chat.lastChild.isOnErrorStatus  %}
					({{ chat.lastChild.errorCount }})
					[{{ chat.lastChild.lastError.message }}]
				{% endif %}
			</a>
		{% endset %}

		{% set table_data = table_data|merge([{
			'seen': visibility_icon,
            'title': '<a href="' ~ chat_view_path ~ '">' ~ chat.shortName(30) ~ '</a>',
			'model': '<a href="' ~ chat_view_path ~ '">' ~ chat.assistantName ~ '</a>',
			'status': status_row,
			'actions': actions,
		}]) %}
	{% endfor %}
	{% include 'table.html.twig' with {
		'tableTitle': 'chats'|localised('assistant'),
		'tableHeaders': [
			'<i class="far fa-eye"></i>',
			'title'|localised,
			'model'|localised('assistant'),
			'status'|localised,
            'actions'|localised,
		],
		'tableData': table_data,
	} only %}

	{% include 'form.html.twig' with {
		'form': form,
		'saveButtonLabel': 'send'|localised
	} only %}

{% endblock %}
