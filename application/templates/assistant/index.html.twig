{% extends 'base.html.twig' %}
{% set breadcrumbs = [
	{'name': 'menu_record'|localised('assistant'), 'href': path('assistant_index')}
	]
%}

{% block pageContentPrimary %}
	{% include 'assistant/_main_selector_buttons.html.twig' with {
		'active_button': 'assistant_index',
	} only %}
{% endblock %}

{% block pageContentSecondary %}
	{% set table_data = {} %}
	{% for chat in chats %}
		{% set chat_view_path = path('assistant_chat_view', {'id': chat.id}) %}
		{% set actions %}
			{% include 'table_action_button.html.twig' with {
				'href': chat_view_path,
				'name': 'view'|localised,
			} only %}
			{% include 'table_action_button_secure.html.twig' with {
				'href': path('assistant_chat_delete', {id: chat.id}),
				'confirmation': 'you_sure_delete'|localised,
				'name': 'delete'|localised,
				'csrf': csrf_token('delete_chat_' ~ chat.id),
			} only %}
		{% endset %}

		{% set visibility_icon = '<i class="fas fa-circle text-nord-11"></i>' %}
		{% if chat.isRead %}
			{% set visibility_icon = '<i class="fas fa-circle text-nord-14"></i>' %}
		{% endif %}

		{% set table_data = table_data|merge([{
			'seen': visibility_icon,
            'title': '<a href="' ~ chat_view_path ~ '">' ~ chat.shortName(30) ~ '</a>',
			'model': '<a href="' ~ chat_view_path ~ '">' ~ chat.assistantName ~ '</a>',
			'status': '<a href="' ~ chat_view_path ~ '">' ~ chat.statusEffective ~ '</a>',
			'actions': actions,
		}]) %}
	{% endfor %}
	{% include 'table.html.twig' with {
		'tableTitle': 'chats'|localised('assistant'),
		'tableHeaders': [
			'<i class="far fa-eye"></i>',
			'title'|localised,
			'model'|localised('assistant'),
			'status'|localised,
            'actions'|localised,
		],
		'tableData': table_data,
	} only %}

	{% include 'form.html.twig' with {
		'form': form,
		'saveButtonLabel': 'send'|localised
	} only %}

{% endblock %}
