{% if text_color is not defined  %}
    {% set text_color = 'text-white' %}
{% endif %}
{% if button_color is not defined  %}
    {% set button_color = 'bg-nord2' %}
{% endif %}
{% if button_color_hover is not defined  %}
    {% set button_color_hover = 'bg-nord3' %}
{% endif %}
<button data-action="{{ href }}" data-confirmation-question="{{ confirmation }}" data-csrf="{{ csrf }}" class="button-secure {{ button_color }} {{ text_color }} hover:{{ button_color_hover }} text-xs font-bold px-3 py-1 rounded outline-none focus:outline-none mr-1 mb-1">{{ name|raw }}</button>
