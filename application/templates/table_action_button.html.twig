{% if text_color is not defined  %}
    {% set text_color = 'text-white' %}
{% endif %}
{% if button_color is not defined  %}
    {% set button_color = 'bg-nord2' %}
{% endif %}
{% if button_color_hover is not defined  %}
    {% set button_color_hover = 'bg-nord3' %}
{% endif %}
<a href="{{ href }}" class="{{ button_color }} {{ text_color }} hover:{{ button_color_hover }} text-xs font-bold px-3 py-1 rounded outline-none focus:outline-none mr-1 mb-1">{{ name }}</a>
